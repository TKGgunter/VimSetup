theme = Builtin Tango Dark
palette = 1           =#e78284
background            = #2E3436
foreground            = #D3D7CF
cursor-color          = #ffffff
selection-background  = #b4d5ff

font-family = Fira Mono

keybind = ctrl+h=goto_split:left
keybind = ctrl+l=goto_split:right
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top

# Turns off integration so that the cursor behaves. When shell integrations
# were on going in and out of vi mode in the shell caused problems.
shell-integration = none
shell-integration-features = false
